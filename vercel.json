{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/docs/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/guide/versions",
      "destination": "/docs/guide/upgrade",
      "permanent": true
    },
    {
      "source": "/docs/guide/versions",
      "destination": "/docs/guide/upgrade",
      "permanent": true
    }
  ]
}
