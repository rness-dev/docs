{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:path*",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/sitemap.xml>; rel=\"sitemap\", </docs/index.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/:path((?!docs/)[^.]+)",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/sitemap.xml>; rel=\"sitemap\", </docs/:path.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/docs/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/next/guide/agent-pulse",
      "destination": "/docs/next/guide/boards",
      "permanent": true
    },
    {
      "source": "/docs/next/guide/agent-pulse",
      "destination": "/docs/next/guide/boards",
      "permanent": true
    },
    {
      "source": "/guide/versions",
      "destination": "/docs/guide/upgrade",
      "permanent": true
    },
    {
      "source": "/docs/guide/versions",
      "destination": "/docs/guide/upgrade",
      "permanent": true
    }
  ]
}
